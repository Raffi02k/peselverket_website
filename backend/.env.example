# ==========================================
# PENSELVERKET - Miljövariabler
# ==========================================

# Välj leverantör: 'web3forms', 'crm', eller 'smtp'
# Lämnas den tom detekteras provider automatiskt baserat på satta nycklar.
FORM_PROVIDER=web3forms

# 1. Web3Forms (Aktiv standard)
# Skaffa eller använd Penselverkets access key:
WEB3FORMS_ACCESS_KEY=d3b5efa0-71db-4377-adae-a614eb39b371

# 2. MediaMagnet CRM (För framtida växling)
CRM_API_URL=https://crm.mediamagnet.se/api/leads
CRM_API_KEY=
PROJECT_ID=penselverket

# 3. SMTP Fallback / Direkt e-post
CONTACT_TO_EMAIL=penselverket@hotmail.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=webbplats@penselverket.se
SMTP_USE_TLS=true

# Tillåtna värdar för CORS och produktion
ALLOWED_HOSTS=localhost,127.0.0.1
