{
  "framework": null,
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "redirects": [
    {
      "source": "/omdome",
      "destination": "https://g.page/r/CWqBg4WCrbzlECE/review",
      "permanent": true
    },
    {
      "source": "/recension",
      "destination": "https://g.page/r/CWqBg4WCrbzlECE/review",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
